# Port for the AI Backend Server
PORT=5000

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here


# OpenAI Model (gpt-4o-mini is recommended for speed and low cost)
OPENAI_MODEL=gpt-4o-mini

# Redis Connection URL (optional - local Redis or Upstash / Redis Cloud)
# Example local: redis://localhost:6379
# Example Upstash: rediss://default:xxxx@xxxx.upstash.io:6379
REDIS_URL=redis://localhost:6379
